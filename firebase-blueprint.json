{
  "entities": {
    "NewsItem": {
      "title": "News Item",
      "description": "A news post for the platform",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" }
      },
      "required": ["title", "content", "author", "date"]
    },
    "CommunityVideo": {
      "title": "Community Video",
      "description": "A video shared by the community",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "thumbnail": { "type": "string" },
        "price": { "type": "string" },
        "video_url": { "type": "string" }
      },
      "required": ["title", "author", "thumbnail", "price", "video_url"]
    },
    "TeamMember": {
      "title": "Team Member",
      "description": "Details about a member of the team",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "bio": { "type": "string" },
        "image": { "type": "string" },
        "icon": { "type": "string" },
        "linkedin": { "type": "string" },
        "twitter": { "type": "string" },
        "github": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["name", "role", "bio", "image", "icon"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Public profile details for users",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/news/{newsId}": {
      "schema": "NewsItem",
      "description": "Collection of news posts"
    },
    "/community_videos/{videoId}": {
      "schema": "CommunityVideo",
      "description": "Collection of community videos"
    },
    "/team/{memberId}": {
      "schema": "TeamMember",
      "description": "Collection of team members"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and settings"
    }
  }
}
