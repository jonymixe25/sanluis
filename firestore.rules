rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return isSignedIn() && (request.auth.token.email == "mixecultura25@gmail.com" || exists(/databases/$(database)/documents/admins/$(request.auth.uid))); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validation Blueprints ---
    function isValidNews(data) {
      return data.keys().hasAll(['title', 'content', 'author', 'date']) &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             data.author is string && data.author.size() <= 100 &&
             data.date is string && // Using string for ISO as per existing DB structure
             (data.get('imageUrl', '') is string) &&
             (data.get('videoUrl', '') is string);
    }

    function isValidVideo(data) {
      return data.keys().hasAll(['title', 'author', 'thumbnail', 'price', 'video_url']) &&
             data.title is string && data.title.size() <= 200 &&
             data.author is string && data.author.size() <= 100 &&
             data.thumbnail is string && data.thumbnail.size() <= 1000 &&
             data.price is string && data.price.size() <= 50 &&
             data.video_url is string && data.video_url.size() <= 1000;
    }

    function isValidMember(data) {
      return data.keys().hasAll(['name', 'role', 'bio', 'photoUrl', 'email', 'uid']) &&
             data.name is string && data.name.size() <= 100 &&
             data.role is string && data.role.size() <= 100 &&
             data.bio is string && data.bio.size() <= 1000 &&
             data.photoUrl is string && data.photoUrl.size() <= 1000 &&
             data.email is string && data.email.size() <= 100 &&
             data.uid is string && data.uid == request.auth.uid;
    }

    // --- Rules ---

    // News Collection
    match /news/{newsId} {
      allow read: if true;
      allow create: if isAdmin() && isValidNews(incoming()) && isValidId(newsId);
      allow update: if isAdmin() && isValidNews(incoming());
      allow delete: if isAdmin();
    }

    // Community Videos Collection
    match /community_videos/{videoId} {
      allow read: if true;
      allow create: if isAdmin() && isValidVideo(incoming()) && isValidId(videoId);
      allow update: if isAdmin() && isValidVideo(incoming());
      allow delete: if isAdmin();
    }

    // Team Members Collection
    match /members/{memberId} {
      allow read: if true;
      allow create: if isVerified() && isValidMember(incoming());
      allow update: if (isAdmin() || (isOwner(existing().uid) && isOwner(incoming().uid))) && (isAdmin() || isValidMember(incoming()));
      allow delete: if isAdmin() || isOwner(existing().uid);
    }

    // Admins Collection (Private)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Google Console for security
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && (!incoming().diff(existing()).affectedKeys().hasAny(['isAdmin', 'role']));
    }
  }
}
